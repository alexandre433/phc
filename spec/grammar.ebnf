(* PHC v0 — Formal Grammar
   Status: canonical (Phase 1 complete; amended with D-023 after commit `3df7de5`).
   Supersedes GitHub issue #1.
*)

(* ===== Lexical structure ===== *)

(* Whitespace and comments are skipped by the lexer, not represented in productions. *)
LineComment   = "//" { any-char-except-newline } newline ;
BlockComment  = "/*" { any-char | BlockComment } "*/" ;       (* nesting allowed *)

(* Identifiers: ASCII for v0. Unicode identifier rules deferred. *)
Identifier    = ( letter | "_" ) { letter | digit | "_" } ;
letter        = "A".."Z" | "a".."z" ;
digit         = "0".."9" ;

(* Sigil-prefixed variable / parameter / field reference (D-023). *)
VarRef        = "$" Identifier ;

(* Literals *)
IntLiteral    = digit { digit | "_" } ;
FloatLiteral  = digit { digit | "_" } "." digit { digit | "_" } ;
BoolLiteral   = "true" | "false" ;
NullLiteral   = "null" ;
(* String literal — every double-quoted string interpolates (D-017). *)
StringLiteral = '"' { StringPart } '"' ;
StringPart    = StringChar | EscapeSeq | InterpExpr | "{{" | "}}" ;
InterpExpr    = "{" Expression "}" ;
EscapeSeq     = "\\" ( '"' | "\\" | "n" | "t" | "r" | "0" | "u" "{" hex+ "}" ) ;
(* StringChar: any character except `"`, `\`, `{`, `}`. *)

(* Reserved keywords — see spec/keywords.md for the canonical list.
   Locked so far: flip, async, await, dyn, public, function, return, void,
   pack, use, class, construct, this, enum, interface, trait, implements,
   match, if, else, while, for, in, break, continue, as, test, true, false, null.
   Contextual: get, set. *)

(* Visibility modifier (D-008) *)
Visibility    = [ "public" ] ;

(* Locked operators / punctuation *)
AssignReassign = ":=" ;
SharedBorrow   = "&" ;       (* prefix on a VarRef for shared borrow *)
MutBorrow      = "&" "flip" ; (* two tokens; lexer keeps them separate *)
Nullable       = "?" ;       (* suffix on a type *)
Arrow          = "->" ;       (* instance member access (D-023) *)
StaticOp       = "::" ;       (* static access (D-023) *)
Dot            = "." ;        (* path separator only (D-023) *)

(* ===== Types ===== *)

Type            = FunctionType | NamedType ;
NamedType       = TypePath [ TypeArgs ] [ Nullable ] ;
FunctionType    = "fn" "(" [ Type { "," Type } ] ")" ":" Type [ Nullable ] ;
TypePath        = Identifier { "." Identifier } ;
TypeArgs        = "<" Type { "," Type } ">" ;

(* Generic parameter list on a declaration (D-014) *)
GenericParams   = "<" GenericParam { "," GenericParam } ">" ;
GenericParam    = Identifier [ ":" BoundList ] ;
BoundList       = TypePath { "+" TypePath } ;

(* ===== Expressions =====
   Precedence table (highest → lowest), C-family conventional:
     1. PrimaryExpr / call / index / instance member access `->` / static access `::` / postfix `?` propagation
     2. unary `!`, unary `-`, borrow `&` / `&flip`, `await`
     3. `as` cast
     4. `*` `/` `%`
     5. `+` `-`
     6. `<` `<=` `>` `>=`
     7. `==` `!=`
     8. `&&`
     9. `||`
    10. `??`  (null-coalesce)
    11. (`match` and `Lambda` are expressions at the top level of this table)
   Right-associative: `as`, `??`. Others left-associative.
   See spec/operators.md for the same information in tabular form.
*)

Expression      = NullCoalesce ;
NullCoalesce    = OrExpr        { "??"  OrExpr } ;
OrExpr          = AndExpr       { "||"  AndExpr } ;
AndExpr         = EqExpr        { "&&"  EqExpr } ;
EqExpr          = CmpExpr       { ( "==" | "!=" ) CmpExpr } ;
CmpExpr         = AddExpr       { ( "<" | "<=" | ">" | ">=" ) AddExpr } ;
AddExpr         = MulExpr       { ( "+" | "-" ) MulExpr } ;
MulExpr         = CastExpr      { ( "*" | "/" | "%" ) CastExpr } ;
CastExpr        = UnaryExpr     { "as" Type } ;
UnaryExpr       = ( "!" | "-" | "await" | BorrowMod ) UnaryExpr
                | PostfixExpr ;
PostfixExpr     = PrimaryExpr { Postfix } ;
Postfix         = "->" Identifier               (* instance member, D-023 *)
                | "::" Identifier               (* static member, D-023 *)
                | "(" [ ArgList ] ")"
                | "[" Expression "]"
                | "?" ;                         (* Result/Option propagation, D-006 amendment *)
ArgList         = Expression { "," Expression } [ "," ] ;

PrimaryExpr     = Literal
                | "$this"
                | VarRef
                | TypeName                      (* type-level: starts a class/enum/trait static chain *)
                | MatchExpr
                | Lambda
                | "(" Expression ")" ;
TypeName        = Identifier ;                  (* parser distinguishes Type vs Var by leading sigil *)

(* Lambda expression (D-016) *)
Lambda          = "(" [ LambdaParams ] ")" [ ":" Type ] "=>" LambdaBody ;
LambdaParams    = LambdaParam { "," LambdaParam } ;
LambdaParam     = [ BorrowMod ] Type VarRef ;
LambdaBody      = Expression
                | Block ;

Literal         = IntLiteral
                | FloatLiteral
                | BoolLiteral
                | NullLiteral
                | StringLiteral ;

(* ===== Statements ===== *)

Statement       = LocalBinding
                | Reassign
                | MemberAssign
                | IfStmt
                | WhileStmt
                | ForStmt
                | ReturnStmt
                | BreakStmt
                | ContinueStmt
                | ExprStmt ;

IfStmt          = "if" "(" Expression ")" Block { "else" "if" "(" Expression ")" Block } [ "else" Block ] ;
WhileStmt       = "while" "(" Expression ")" Block ;
ForStmt         = "for" "(" Type VarRef "in" Expression ")" Block ;
ReturnStmt      = "return" [ Expression ] ";" ;
BreakStmt       = "break" ";" ;
ContinueStmt    = "continue" ";" ;
ExprStmt        = Expression ";" ;

(* Local binding (D-010 + D-023) *)
LocalBinding    = [ "flip" ] Type VarRef "=" Expression ";" ;
Reassign        = ReassignLhs ":=" Expression ";" ;
ReassignLhs     = VarRef { Arrow Identifier } ;   (* e.g. $u, $u->loginCount *)

(* Member assignment (D-005 amendment, 2026-05-15).
   `$obj->field = expr;` writes the field directly without recursing
   through any setter hook. The LHS must be a `->` chain rooted at a
   VarRef (or `$this`); a bare `$x = expr;` is NOT a MemberAssign and
   remains illegal — use `:=` after declaring `$x` as `flip`. This
   subsumes the old D-018 hook-setter exception: the same form works
   in any block, not just SetHook bodies. *)
MemberAssign    = MemberAssignLhs "=" Expression ";" ;
MemberAssignLhs = VarRef Arrow Identifier { Arrow Identifier } ;

(* ===== Declarations ===== *)

(* Function declaration (D-009 + D-023 + D-052 attributes) *)
FunctionDecl    = { Attribute } Visibility [ "async" ] "function" Identifier [ GenericParams ] "(" [ ParamList ] ")" ":" Type Block ;
Attribute       = "@" Identifier ;   (* D-052: v0 recognises only `@noinline` *)
ParamList       = Param { "," Param } [ "," ] ;
Param           = [ BorrowMod ] Type VarRef ;
BorrowMod       = "&" | "&" "flip" ;
Block           = "{" { Statement } "}" ;

(* Pack declaration and imports (D-011) *)
SourceFile      = PackDecl { UseDecl } { Item } ;
PackDecl        = "pack" PackPath ";" ;
UseDecl         = "use" PackPath [ "." "{" ImportList "}" ] ";" ;
PackPath        = Identifier { "." Identifier } ;
ImportList      = Identifier { "," Identifier } ;
Item            = FunctionDecl
                | ClassDecl
                | EnumDecl
                | InterfaceDecl
                | TraitDecl
                | TestDecl ;

(* Class declaration (D-012 + D-023) *)
ClassDecl       = Visibility "class" Identifier [ GenericParams ] [ "implements" InterfaceList ] "{" { ClassMember } "}" ;
InterfaceList   = TypePath { "," TypePath } ;
ClassMember     = ConstructDecl
                | TraitUse
                | FieldDecl
                | FunctionDecl ;
ConstructDecl   = "construct" "(" [ ConstructParams ] ")" Block ;
ConstructParams = ConstructParam { "," ConstructParam } [ "," ] ;
ConstructParam  = [ "public" ] [ BorrowMod ] [ "flip" ] Type VarRef ;
FieldDecl       = Visibility [ "flip" ] Type VarRef [ "=" Expression ] [ HookBlock ] ";" ;
TraitUse        = "use" TypePath ";" ;

(* Property hooks (D-018 + D-023) *)
HookBlock       = "{" { Hook } "}" ;
Hook            = GetHook | SetHook ;
GetHook         = "get" "=>" Expression ";"
                | "get" Block ;
SetHook         = "set" "(" Type VarRef ")" Block ;
(* `$this->field = expr;` inside a SetHook body uses the general
   MemberAssign form (D-005a, 2026-05-15) and writes the backing
   field directly without recursing through the setter. *)

(* Enum declaration (D-012 + D-023) *)
EnumDecl        = Visibility "enum" Identifier [ ":" Type ] "{" EnumVariants "}" ;
EnumVariants    = EnumVariant { "," EnumVariant } [ "," ] ;
EnumVariant     = Identifier [ "=" Literal ] ;

(* Interface and trait declarations (D-013) *)
InterfaceDecl   = Visibility "interface" Identifier [ GenericParams ] "{" { MethodSig } "}" ;
MethodSig       = "function" Identifier [ GenericParams ] "(" [ ParamList ] ")" ":" Type ";" ;

TraitDecl       = Visibility "trait" Identifier [ GenericParams ] "{" { FunctionDecl } "}" ;

(* Test declaration (D-021, provisional) *)
TestDecl        = "test" StringLiteral Block ;

(* ===== Pattern matching (D-015 + D-023) ===== *)

MatchExpr       = "match" "(" Expression ")" "{" MatchArms "}" ;
MatchArms       = MatchArm { "," MatchArm } [ "," ] ;
MatchArm        = Pattern [ "if" Expression ] "=>" Expression ;
Pattern         = OrPattern ;
OrPattern       = AtomPattern { "|" AtomPattern } ;
AtomPattern     = "_"
                | Literal
                | EnumVariantPath
                | VarRef ;                       (* binding capture, e.g. $s *)
EnumVariantPath = Identifier "::" Identifier ;   (* e.g. Status::Ok *)

(* ===== Async ===== *)
(* `async function` is covered by FunctionDecl. `await` is a unary prefix in
   UnaryExpr. `taskGroup` and structured-concurrency syntax are finalised in
   Phase 5 / Phase 6 (D-022 provisional). *)
