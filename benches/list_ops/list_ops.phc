pack bench;

function main(): void {
    flip list<int> $xs = list();
    flip int $i = 0;
    while ($i < 100000) {
        $xs->push(100000 - $i);
        $i := $i + 1;
    }
    list<int> $sorted = $xs->sort(fn(int $a, int $b): int {
        if ($a < $b) { return -1; }
        if ($a > $b) { return 1; }
        return 0;
    });
    int $sum = $sorted->fold(0, fn(int $acc, int $x): int { return $acc + $x; });
    Logger::info("done");
}
