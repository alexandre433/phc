pack bench;

function main(): void {
    flip list<int> $xs = list();
    flip int $i = 0;
    while ($i < 100000) {
        $xs->push(100000 - $i);
        $i := $i + 1;
    }
    list<int> $sorted = $xs->sort((int $a, int $b) => $a - $b);
    int $sum = $sorted->fold(0, (int $acc, int $x) => $acc + $x);
    Logger::info("sum = {$sum}");
}
