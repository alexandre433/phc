pack bench;

public class Counter {
    flip int $value = 0;

    construct(int $start) {
        $this->value := $start;
    }

    public function inc(): void {
        $this->value := $this->value + 1;
    }

    public function get(): int {
        return $this->value;
    }
}

function main(): void {
    Counter $c = Counter(0);
    flip int $i = 0;
    while ($i < 10000000) {
        $c->inc();
        $i := $i + 1;
    }
    Logger::info("done");
}
