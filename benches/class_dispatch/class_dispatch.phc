pack bench;

// Real method-dispatch throughput. The loop count is read from stdin
// so no compiler can constant-fold the loop, and `inc` is marked
// `@noinline` (D-052) so gcc emits a genuine call per iteration
// instead of inlining + collapsing it to `value = count`. The peer
// C/Rust/Go sources use their own noinline pragmas for parity.
public class Counter {
    flip int $value = 0;

    construct(int $start) {
        $this->value := $start;
    }

    @noinline public function inc(): void {
        $this->value := $this->value + 1;
    }

    public function get(): int {
        return $this->value;
    }
}

function main(): void {
    int $count = int::parse(io::readLine()->unwrapOr("0"))->unwrapOr(0);
    Counter $c = Counter(0);
    flip int $i = 0;
    while ($i < $count) {
        $c->inc();
        $i := $i + 1;
    }
    int $r = $c->get();
    io::println("counter = {$r}");
}
