pack examples.class_user;

public interface Greet { function greet(): string; }

public trait Loggable {
    function log(): void { Logger::info($this->greet()); }
}

public class User implements Greet {
    use Loggable;

    construct(
        public string $name,
        public int $age,
    ) {}

    flip int $loginCount = 0;

    public function greet(): string {
        return "Hi, {$this->name} ({$this->age})";
    }

    public function recordLogin(): void {
        $this->loginCount := $this->loginCount + 1;
    }
}

function main(): void {
    User $u = User("Ada", 36);
    $u->log();
    $u->recordLogin();
    $u->recordLogin();
    Logger::info("logins = {$u->loginCount}");
}
