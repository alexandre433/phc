pack examples.list;

// D-027 v0a: list<T> with push / len / at, indexing, for-loop.
// Reference semantics — handle is shared; methods mutate the
// heap-allocated backing storage.

public function main(): void {
    list<int> $xs = list();
    $xs->push(10);
    $xs->push(20);
    $xs->push(30);

    if ($xs->len() == 3) { Logger::info("len ok"); }
    if ($xs->at(1) == 20) { Logger::info("at ok"); }
    if ($xs[0] == 10) { Logger::info("index ok"); }

    flip int $sum = 0;
    for (int $x in $xs) { $sum := $sum + $x; }
    if ($sum == 60) { Logger::info("for ok"); }

    // D-045: sort
    list<int> $unsorted = list();
    $unsorted->push(3);
    $unsorted->push(1);
    $unsorted->push(2);
    list<int> $sorted = $unsorted->sort((int $a, int $b) => $a - $b);
    if ($sorted->at(0) == 1 && $sorted->at(1) == 2 && $sorted->at(2) == 3) {
        Logger::info("sort asc ok");
    }
    list<int> $desc = $unsorted->sort((int $a, int $b) => $b - $a);
    if ($desc->at(0) == 3 && $desc->at(1) == 2 && $desc->at(2) == 1) {
        Logger::info("sort desc ok");
    }

    // D-046: flatMap
    list<int> $pairs = list();
    $pairs->push(1);
    $pairs->push(2);
    list<int> $doubled = $pairs->flatMap((int $x) => {
        list<int> $inner = list();
        $inner->push($x);
        $inner->push($x * 10);
        return $inner;
    });
    if ($doubled->len() == 4 && $doubled->at(0) == 1 && $doubled->at(1) == 10 && $doubled->at(2) == 2 && $doubled->at(3) == 20) {
        Logger::info("flatMap ok");
    }
}
